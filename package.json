{
  "name": "hikkomanga",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "analyze": "ANALYZE=true vite build",
    "build": "vite build && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs && node scripts/check-verification.mjs --built && node scripts/check-budgets.mjs",
    "build:spa": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-verification.mjs && node --test scripts/unit-verification.mjs && node scripts/smoke-data-layer.mjs && node scripts/unit-auth-notify.mjs && node scripts/unit-covers.mjs && node scripts/unit-admin-links.mjs && npm run test:routing && npm run test:rewrites && npm run test:captcha && npm run test:page-formats && npm run test:pdf && npm run test:chapters-import && npm run test:submit-chapters",
    "test:verification": "node scripts/check-verification.mjs",
    "test:unit": "node scripts/unit-auth-notify.mjs",
    "test:ui": "node scripts/unit-admin-buttons.mjs",
    "test:login-ui": "node --conditions=development scripts/unit-login-dev.mjs",
    "test:submissions": "node scripts/unit-submissions.mjs",
    "test:covers": "node scripts/unit-covers.mjs",
    "test:smoke": "node scripts/smoke-data-layer.mjs",
    "test:verification:unit": "node --test scripts/unit-verification.mjs",
    "check:supabase": "node scripts/check-supabase-project.mjs",
    "check:covers": "node scripts/check-covers.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:submissions": "node scripts/check-submissions.mjs",
    "test:links": "node scripts/unit-admin-links.mjs",
    "test:routing": "node scripts/unit-admin-routing.mjs",
    "test:routing:browser": "node scripts/browser-admin-routing.mjs",
    "test:rewrites": "node scripts/unit-spa-rewrites.mjs",
    "test:captcha": "node scripts/unit-captcha.mjs",
    "test:page-formats": "node scripts/unit-page-formats.mjs",
    "test:pdf": "node scripts/unit-pdf-to-pages.mjs",
    "test:chapters-import": "node scripts/unit-chapters-import.mjs",
    "test:submit-chapters": "node scripts/unit-submit-chapters.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMloaderJava/hikkomanga.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DMloaderJava/hikkomanga/issues"
  },
  "homepage": "https://github.com/DMloaderJava/hikkomanga#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.45.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.35",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "json5": "^2.2.3",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
