# Скопируйте в `.env` (файл в .gitignore) для локальной разработки.
# Lovable инжектит эти же переменные сам при подключении Supabase-проекта.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Достаточно одной из двух: классический anon key (eyJ...) — или новый
# publishable key (sb_publishable_...), который выдаёт Lovable.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Необязательно, добавляет Lovable
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# SEO: канонический домен БЕЗ слеша на конце. Используется для canonical,
# og:url, sitemap.xml и robots.txt. Без него sitemap соберётся на
# https://hikkomanga.vercel.app — обязательно задайте на Vercel.
VITE_SITE_URL=https://hikkomanga.vercel.app

# Пререндер глав (страниц читалки) — 1 (по умолчанию) или 0, чтобы не тратить
# crawl-бюджет на «тонкие» страницы. Лимит страниц — PRERENDER_MAX_URLS.
# PRERENDER_CHAPTERS=1
# PRERENDER_MAX_URLS=1000

# Серверные миниатюры обложек (srcset 400w/800w) через Supabase Image
# Transformation. Включать ТОЛЬКО если трансформации включены на проекте
# (план Pro). Без флага CoverImage использует оригинальный URL.
# VITE_COVER_TRANSFORMS=1

# Только для AI-анализа и озвучки в `npm run dev` (dev-middleware в vite.config.ts).
# Без префикса VITE_ — на клиент не попадает. В проде это секрет edge-функции.
# GEMINI_API_KEY=

# Login Guard: обязательное подтверждение входа (письмо владельцу).
# Без подтверждения из письма админ-панель не откроется.
# ОБЯЗАТЕЛЬНО реальный адрес (не @example.com). В проде — supabase secrets set.
# Без значения dev-мидлварь эмулирует письмо в консоль, но не шлёт его.
OWNER_NOTIFY_EMAIL=
# RESEND_API_KEY=re_xxxxxxxxxxxx   # без ключа в dev — эмуляция + ссылки в UI
# OWNER_NOTIFY_FROM=Hikkomanga Login Guard <onboarding@resend.dev>
