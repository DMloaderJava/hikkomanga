# Скопируйте в `.env` (файл в .gitignore) для локальной разработки.
# Lovable инжектит эти же переменные сам при подключении Supabase-проекта.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Достаточно одной из двух: классический anon key (eyJ...) — или новый
# publishable key (sb_publishable_...), который выдаёт Lovable.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Необязательно, добавляет Lovable
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# SEO: канонический домен БЕЗ слеша на конце. Используется для canonical,
# og:url, sitemap.xml и robots.txt. Без него sitemap соберётся на
# https://hikkomanga.vercel.app — обязательно задайте на Vercel.
VITE_SITE_URL=https://hikkomanga.vercel.app

# Пререндер глав (страниц читалки) — 1 (по умолчанию) или 0, чтобы не тратить
# crawl-бюджет на «тонкие» страницы. Лимит страниц — PRERENDER_MAX_URLS.
# PRERENDER_CHAPTERS=1
# PRERENDER_MAX_URLS=1000

# Только для AI-анализа и озвучки в `npm run dev` (dev-middleware в vite.config.ts).
# Без префикса VITE_ — на клиент не попадает. В проде ключ у каждого админа свой
# (/admin/settings), а общий GEMINI_API_KEY читает только dev-middleware.
# Подходит и новый auth-ключ `AQ.…` (их сейчас выдаёт AI Studio), и старый `AIza…`:
# ключ уходит в Gemini заголовком x-goog-api-key, модели — gemini-3.8-flash /
# gemini-3.8-flash-tts.
# GEMINI_API_KEY=

# Login Guard: обязательное подтверждение входа (письмо владельцу).
# Без подтверждения из письма админ-панель не откроется.
# ОБЯЗАТЕЛЬНО реальный адрес (не @example.com). В проде — supabase secrets set.
# Без значения dev-мидлварь эмулирует письмо в консоль, но не шлёт его.
OWNER_NOTIFY_EMAIL=
# RESEND_API_KEY=re_xxxxxxxxxxxx   # без ключа в dev — эмуляция + ссылки в UI
# OWNER_NOTIFY_FROM=Hikkomanga Login Guard <onboarding@resend.dev>

# ── Анонимные заявки на тайтл («Предложить тайтл») ────────────────────────────
# Провайдер капчи: turnstile (по умолчанию) | hcaptcha | recaptcha (v2). Переключение не
# требует правок кода: виджет, CSP и секреты уже поддерживают все три.
VITE_CAPTCHA_PROVIDER=turnstile
# Site key из Cloudflare Dashboard → Turnstile (тип Widget, домен сайта).
VITE_TURNSTILE_SITE_KEY=
# Если переключаетесь на hCaptcha — раскомментируйте и заполните:
# VITE_HCAPTCHA_SITE_KEY=
# Для Google reCAPTCHA v2: VITE_CAPTCHA_PROVIDER=recaptcha
# VITE_RECAPTCHA_SITE_KEY=

# Секреты edge-функций (НЕ VITE_): задаются на сервере
#   supabase secrets set TURNSTILE_SECRET_KEY=... RATE_LIMIT_SALT=...
# при reCAPTCHA v2: RECAPTCHA_SECRET_KEY=... CAPTCHA_PROVIDER=recaptcha
# при hCaptcha: HCAPTCHA_SECRET_KEY=... CAPTCHA_PROVIDER=hcaptcha
# RATE_LIMIT_SALT — случайная строка ≥32 символов (openssl rand -hex 32).

# Максимум страниц в одном PDF при загрузке главы (положительное целое; default 500).
VITE_MAX_PDF_PAGES=500

# Локальный/staging CLI-рендер озвученной главы в MP4:
#   npm run dev
#   npm run render:chapter -- --chapter <chapter-id>
# Renderer намеренно отказывается использовать URL из .env.production.
RENDER_BASE_URL=http://127.0.0.1:5173
# Для Login Guard удобнее заранее одобренный storage state:
# RENDER_STORAGE_STATE=./.auth/admin.json
# Либо пароль админа (после входа потребуется подтвердить Login Guard по email):
# RENDER_ADMIN_EMAIL=
# RENDER_ADMIN_PASSWORD=
# RENDER_LOGIN_TIMEOUT_MS=180000
# По умолчанию renderer отказывается работать с URL из .env.production.
# Включайте только если staging осознанно делит Supabase-проект с production:
# RENDER_ALLOW_PROD_DB=1
# Опционально переопределить бинарь из @ffmpeg-installer/ffmpeg:
# FFMPEG_PATH=ffmpeg
